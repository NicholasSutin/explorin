# Production secrets for the explorin-app Worker. Copy to .env.prod (gitignored) and push with
#   npm run secrets:web          (from the repo root; add --dry-run to see what would be sent)
# Non-secret settings (BETTER_AUTH_URL, TURNSTILE_SITE_KEY, TURNSTILE_HOSTNAMES, AUTH_FROM_EMAIL) are
# `vars` in wrangler.jsonc and are skipped if listed here. Empty values are skipped too.

GEMINI_API_KEY=
DATABASE_URL=
NIMBLE_API_KEY=
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=

# Accounts. Without these three, sign-in/sign-up answer 503 and only the demo works.
BETTER_AUTH_SECRET=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
