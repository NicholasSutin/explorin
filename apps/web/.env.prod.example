# Production secrets for the explorin-app Worker. Copy to .env.prod (gitignored) and push with
#   npm run secrets:web:update   (from the repo root; secrets:web shows status, :new creates only, :sync also deletes)
# Non-secret settings (BETTER_AUTH_URL, TURNSTILE_SITE_KEY, TURNSTILE_HOSTNAMES, AUTH_FROM_EMAIL) are
# `vars` in wrangler.jsonc and are skipped if listed here. Empty values are skipped too.

GEMINI_API_KEY=
# Neon `production` branch: `neon env pull --branch production --service postgres --file .env.prod` writes both.
# The Worker reads the database through Hyperdrive (configured with the UNPOOLED one); DATABASE_URL is its
# fallback. `npm run db:migrate:prod` uses DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NIMBLE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Accounts. Without these three, sign-in/sign-up answer 503 and nothing past the landing page works.
BETTER_AUTH_SECRET=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
