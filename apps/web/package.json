{
	"name": "@explorin/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && wrangler types && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
		"db:seed": "node --env-file=.env --import tsx scripts/seed-places.ts",
		"db:seed-reflections": "node --env-file=.env --import tsx scripts/seed-reflections.ts",
		"ingest": "node --env-file=.env --import tsx scripts/ingest-reviews.ts",
		"nimble:smoke": "node --env-file=.env --import tsx scripts/nimble-smoke.ts",
		"setup": "npm run db:migrate -- --apply && npm run db:seed",
		"deploy": "DEPLOY_TARGET=cloudflare vite build && wrangler deploy",
		"cf:types": "wrangler types",
		"build:cf": "DEPLOY_TARGET=cloudflare vite build",
		"preview:cf": "DEPLOY_TARGET=cloudflare vite build && wrangler dev",
		"gemini:smoke": "node --env-file=.env --import tsx scripts/gemini-smoke.ts",
		"db:seed-persona": "node --env-file=.env --import tsx scripts/seed-persona.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/google.maps": "^3.66.7",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.149.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@google/genai": "^2.28.0",
		"@lucide/svelte": "^1.55.0",
		"better-auth": "^1.7.7",
		"html-to-image": "^1.11.13",
		"kysely": "^0.29.6",
		"kysely-postgres-js": "^5.0.1",
		"libheif-js": "^1.23.5",
		"postgres": "^3.4.9",
		"zod": "^4.6.6"
	}
}
