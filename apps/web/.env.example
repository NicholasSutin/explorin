# Copy to .env (never commit .env). For Cloudflare: secrets via `npx wrangler secret put NAME`, non-secrets in wrangler.jsonc vars.
# Local dev: `.dev.vars` is what wrangler reads; `.env` is what the scripts read. Keep both in sync (or symlink).

# Google AI Studio key: planner picks, tier-list narrowing, keepsake drafts and embeddings.
GEMINI_API_KEY=

# Server-side Google Cloud key with "Places API (New)" and "Maps Static API" enabled (optional). Verifies planned
# stops, adds their photos and reviews, and draws the static maps (trip fallback, scrapbook stamp).
# Restrict the key to those APIs in the Cloud console. Cost: Text Search Pro + Place Photos, mostly inside
# Google's free monthly caps at this scale. Without it, stops have no pins or photos.
GOOGLE_MAPS_API_KEY=
# Geocoding API on the same key (optional) places NYC street-segment events ("X between A and B") on the trip map.
# Parks, plazas and venues use NYC's free GeoSearch and need nothing.

# Browser key for the interactive trip map: enable "Maps JavaScript API" and create a separate key restricted to
# HTTP referrers (localhost:5173/*, 127.0.0.1:4173/*, app.explorin.app/*) and to the Maps JavaScript API only.
# Public by design. Without it trip pages fall back to a static snapshot. $7 / 1k map loads after 10k free per month.
GOOGLE_MAPS_BROWSER_KEY=

# Per-person monthly allowance in credits (1 credit = $0.001 of estimated upstream cost). Default 2000.
# MONTHLY_CREDITS=2000

# Postgres with pgvector. Tiger Cloud free service works; any Postgres 15+ with `CREATE EXTENSION vector` is fine.
# e.g. postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Photos: Cloudflare R2 bucket `explorin-photos` bound as PHOTOS in wrangler.jsonc (no env var needed).

# Nimble SDK API key (Settings > API Keys > Create New API Key, shown once). Optional; powers the planner's web
# search. Without it, New York plans come from the curated set and other cities get a clear error.
NIMBLE_API_KEY=
# NIMBLE_BASE_URL=https://sdk.nimbleway.com

# Accounts (better-auth: emailed sign-up link, then email + password; Turnstile on the forms). Tables are in scripts/schema.sql
# (npm run db:migrate -- --apply). Without BETTER_AUTH_SECRET sign-in is disabled, and every page needs an account.
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin used in verification / reset links. Leave unset in dev (derived from the request); set in production.
# BETTER_AUTH_URL=https://app.explorin.app
# Cloudflare Turnstile (dashboard > Turnstile). Dev: these are Cloudflare's "always passes" test keys.
# Production: the real keys, and TURNSTILE_HOSTNAMES=app.explorin.app
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=
# Resend for the sign-up link and reset emails. Unset in dev: the link is printed to the server console instead.
RESEND_API_KEY=
# AUTH_FROM_EMAIL=Explorin <hello@explorin.app>

# Minimum to run: DATABASE_URL and BETTER_AUTH_SECRET (accounts), plus GEMINI_API_KEY and NIMBLE_API_KEY for live
# plans. See MVP.md for what each missing key turns off.
