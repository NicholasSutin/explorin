# Copy to .env (never commit .env). For Cloudflare: secrets via `npx wrangler secret put NAME`, non-secrets in wrangler.jsonc vars.
# Local dev: `.dev.vars` is what wrangler reads; `.env` is what the scripts read. Keep both in sync (or symlink).

# Google AI Studio key. Billing must be enabled: Maps grounding is not on the free tier.
GEMINI_API_KEY=

# Google Cloud API key with "Places API (New)" and "Maps Static API" enabled (optional). Adds real place photos,
# reviews, and stylized maps (cards, live banner, scrapbook stamp, memories map).
# Restrict the key to Places API (New) in the Cloud console. Cost: Text Search Pro + Place Photos, both inside
# the free monthly caps for a demo. Without it, cards show the illustrated placeholder.
GOOGLE_MAPS_API_KEY=
# Optional Cloud-based map style ID (Google Maps Platform > Map Styles > Map IDs) for /api/map?style=cloud.
# Without it, the built-in "paper" and "ink" styles are used. Requires "Maps Static API" enabled on the key.
# GOOGLE_MAPS_MAP_ID=

# Postgres with pgvector. Tiger Cloud free service works; any Postgres 15+ with `CREATE EXTENSION vector` is fine.
# e.g. postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Photos: Cloudflare R2 bucket `explorin-photos` bound as PHOTOS in wrangler.jsonc (no env var needed).

# Nimble SDK API key (Settings > API Keys > Create New API Key, shown once). Optional; powers web search,
# live place context (google_maps_search template) and review-page extraction. Features degrade without it.
NIMBLE_API_KEY=
# NIMBLE_BASE_URL=https://sdk.nimbleway.com

# Set to "false" to disable the cached response for the scripted demo prompt.
# DEMO_CACHE=true

# Accounts (better-auth: email + password, email verification, Turnstile on the forms). Tables are in scripts/schema.sql
# (npm run db:migrate). Without BETTER_AUTH_SECRET sign-in is disabled and the demo keeps working.
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin used in verification / reset links. Leave unset in dev (derived from the request); set in production.
# BETTER_AUTH_URL=https://app.explorin.app
# Cloudflare Turnstile (dashboard > Turnstile). Dev: these are Cloudflare's "always passes" test keys.
# Production: the real keys, and TURNSTILE_HOSTNAMES=app.explorin.app
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=
# Resend for the confirmation and reset emails. Unset in dev: the link is printed to the server console instead.
RESEND_API_KEY=
# AUTH_FROM_EMAIL=Explorin <hello@explorin.app>

# Explorin MVP: only NIMBLE_API_KEY + GEMINI_API_KEY are needed for live discovery/AI.
# No keys or database are needed for the explicitly labeled NYC demo. See MVP.md.
