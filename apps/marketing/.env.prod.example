# Production secrets for the explorin-marketing Worker. Copy to .env.prod (gitignored) and push with
#   npm run secrets:marketing    (from the repo root; add --dry-run to see what would be sent)
# Non-secret settings (APP_URL, TURNSTILE_SITE_KEY, TURNSTILE_HOSTNAMES) are `vars` in wrangler.jsonc.

TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=Explorin <hi@explorin.app>
