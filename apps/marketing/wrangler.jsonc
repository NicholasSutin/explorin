{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "94015fdd2754ebfbcb440e274d9f62c8", // Cloudflare account "explorin"
	"name": "explorin-marketing",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"observability": { "enabled": true },
	// Waitlist storage. Create once: npx wrangler d1 create explorin-waitlist
	// Schema changes: add a file under migrations/ and run: npm run db:migrate
	"d1_databases": [
		{
			"binding": "WAITLIST",
			"database_name": "explorin-waitlist",
			"database_id": "06558a86-8204-46a8-b28a-85f0f065027c",
			"migrations_dir": "migrations"
		}
	],
	// Non-secret settings (TURNSTILE_SITE_KEY, TURNSTILE_HOSTNAMES, APP_URL, WAITLIST_FROM_EMAIL) can go here as
	// "vars"; secrets (TURNSTILE_SECRET_KEY, RESEND_API_KEY) via `npx wrangler secret put <NAME>`. Defaults: src/env.ts.
	// APP_URL is deliberately absent: explorin.app hosts this landing page, not the app, so "Open the app" stays
	// hidden until the app has its own public hostname (e.g. "APP_URL": "https://app.explorin.app").
	"vars": {
		"TURNSTILE_SITE_KEY": "***REMOVED-TURNSTILE-SECRET***",
		"TURNSTILE_HOSTNAMES": "explorin.app,localhost,explorin-marketing.explorin.workers.dev"
	}
}
