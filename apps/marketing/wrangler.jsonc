{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "94015fdd2754ebfbcb440e274d9f62c8", // Cloudflare account "explorin"
	"name": "explorin-marketing",
	"main": ".svelte-kit/cloudflare/_worker.js",
	// explorin.app is the landing page (this Worker). Cloudflare creates the DNS record and certificate on deploy;
	// www -> apex and http -> https are Redirect Rules in the dashboard (Rules > Redirect Rules). www needs a
	// proxied placeholder DNS record (AAAA www 100::) so the request reaches Cloudflare; it is not routed here.
	"routes": [{ "pattern": "explorin.app", "custom_domain": true }],
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"observability": { "enabled": true },
	// Waitlist storage. Create once: npx wrangler d1 create explorin-waitlist
	// Schema changes: add a file under migrations/ and run: npm run db:migrate
	"d1_databases": [
		{
			"binding": "WAITLIST",
			"database_name": "explorin-waitlist",
			"database_id": "06558a86-8204-46a8-b28a-85f0f065027c",
			"migrations_dir": "migrations"
		}
	],
	// Non-secret settings (TURNSTILE_SITE_KEY, TURNSTILE_HOSTNAMES, APP_URL, WAITLIST_FROM_EMAIL) live here as
	// "vars"; secrets (TURNSTILE_SECRET_KEY, RESEND_API_KEY) via `npx wrangler secret put <NAME>`. Defaults: src/env.ts.
	// explorin.app hosts this landing page; the app (Worker "explorin-app") is at app.explorin.app.
	"vars": {
		"APP_URL": "https://app.explorin.app",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFUOm-CrWG7U8E3X",
		"TURNSTILE_HOSTNAMES": "explorin.app,explorin-marketing.explorin.workers.dev",
		"WAITLIST_FROM_EMAIL": "Explorin <hi@explorin.app>"
	}
}
