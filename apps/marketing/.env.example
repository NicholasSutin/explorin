# Copy to .env for local dev. Never commit .env. On Cloudflare, set secrets with `npx wrangler secret put <NAME>`
# from apps/marketing and non-secret values as "vars" in wrangler.jsonc. Defaults live in src/env.ts.

# Cloudflare Turnstile widget (dash.cloudflare.com -> Turnstile). The waitlist form only submits after a passed
# challenge, and the server refuses every submission until both keys are set.
# Site key: public, rendered into the page.
TURNSTILE_SITE_KEY=
# Secret key: server-side only, used for siteverify.
TURNSTILE_SECRET_KEY=
# Hostnames a token may have been solved on, comma-separated. Local: "localhost,127.0.0.1" (add them to the
# widget's hostnames in the dashboard). Production (wrangler.jsonc vars): the real site hostnames only.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Cloudflare's always-pass test pair works on any hostname and reports hostname "example.com". It accepts any
# token string, so it proves the wiring, not the protection; it is only honoured when running `vite dev`.
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   TURNSTILE_HOSTNAMES=example.com

# Resend (resend.com) for the welcome email. Optional: without a key, joining still works and nothing is sent.
RESEND_API_KEY=
# Sender; must be on a domain verified in Resend. onboarding@resend.dev only delivers to the account owner.
WAITLIST_FROM_EMAIL=Explorin <onboarding@resend.dev>

# Where "Open the app" and the welcome email's demo link point. Leave empty until the app has its own public
# hostname: the button is then not rendered and the email omits the link. Never set it to this site's own
# hostname (explorin.app is the landing page). Locally, point it at the web app's dev server.
APP_URL=http://localhost:5173
